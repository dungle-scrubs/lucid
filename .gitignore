# Planner working state (decision ledger, RFC drafts) - kept local, never tracked
.plans/

# SQLite transient files
*.db-wal
*.db-shm

# One-off manual backups (kept on disk, not version-controlled)
_backup_pre_revert_*/
**/_backup_pre_revert_*/

# macOS
.DS_Store

# Dependencies
node_modules/

# Build artifacts (regenerated by `bun run build`)
/dist/

# The embedded client bundle. Generated, and deliberately not tracked: Bun's
# bundler does not emit byte-identical output for identical input (identifier
# mangling and emit length both move between runs), so a committed copy could
# only ever be verified by a byte comparison that fails at random. It is built
# by `prepare` on install and by CI, so nothing consumes a stale one.
/src/server/client-bundle.generated.ts

# Test outputs
/test/e2e/.artifacts/
/test-results/
/playwright-report/

# Session state written by Lucid during local runs

# Bun build temp artifacts
*.bun-build

# Review records now live under `.lucid/` and are committable by default (plan
# 02): the record's own `.gitignore` keeps only its machine-local `run/` out of
# git. The old sibling-era rules that hid review HTML at the repo root
# (workspace-overview.html, /yo-yo.html, /test*.html, /asdf.html) were the R1
# trap and are gone; do not re-add a rule that ignores a `.lucid/**` artifact.

# Loose HTML recovered from a harness's edit history after /private/tmp was
# cleared - orphaned files, not records. The clean records that DO live under
# lucid-recovered/.lucid/ stay ignored with the junk; commit them surgically if
# ever wanted, rather than un-ignoring the whole recovery pile.
/lucid-recovered/
.claude/worktrees/
