# Planner working state (decision ledger, RFC drafts) - kept local, never tracked
.plans/

# SQLite transient files
*.db-wal
*.db-shm

# One-off manual backups (kept on disk, not version-controlled)
_backup_pre_revert_*/
**/_backup_pre_revert_*/

# macOS
.DS_Store

# Dependencies
node_modules/

# Build artifacts (regenerated by `bun run build`)
/dist/

# The embedded client bundle. Generated, and deliberately not tracked: Bun's
# bundler does not emit byte-identical output for identical input (identifier
# mangling and emit length both move between runs), so a committed copy could
# only ever be verified by a byte comparison that fails at random. It is built
# by `prepare` on install and by CI, so nothing consumes a stale one.
/src/server/client-bundle.generated.ts

# Test outputs
/test/e2e/.artifacts/
/test-results/
/playwright-report/

# Session state written by Lucid during local runs

# Bun build temp artifacts
*.bun-build
workspace-overview.html

# Artifacts authored into the repo root while testing the shell. They are
# review material, not source - each keeps its own .lucid/ log beside it.
/yo-yo.html
/test*.html
/asdf.html
