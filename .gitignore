# SQLite transient files (plan.db itself IS tracked - it is the canonical plan state)
*.db-wal
*.db-shm

# One-off manual backups (kept on disk, not version-controlled)
_backup_pre_revert_*/
**/_backup_pre_revert_*/

# macOS
.DS_Store

# Dependencies
node_modules/

# Build artifacts (regenerated by `bun run build`)
/dist/

# Test outputs
/test/e2e/.artifacts/
/test-results/
/playwright-report/

# Session state written by Lucid during local runs
.lucid/

# Bun build temp artifacts
*.bun-build
