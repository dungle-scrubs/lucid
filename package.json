{
  "name": "lucid-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "git config --local core.hooksPath .git/hooks && lefthook install --force"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@dungle-scrubs/harness-cli-normalizer": "0.5.7"
  }
}
