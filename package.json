{
  "name": "lucid",
  "version": "0.6.0",
  "description": "Correct a plan everywhere it is wrong, in one pass",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/lucid.git"
  },
  "homepage": "https://github.com/dungle-scrubs/lucid#readme",
  "bugs": {
    "url": "https://github.com/dungle-scrubs/lucid/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "html",
    "artifact",
    "annotation",
    "review",
    "bun",
    "llm"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "src/cli/main.ts",
  "bin": {
    "lucid": "./dist/lucid"
  },
  "scripts": {
    "build:client": "bun run scripts/build-client.ts",
    "build:binary": "bun run scripts/build-binary.ts",
    "build": "bun run build:client && bun run build:binary",
    "dev": "bun run scripts/dev.ts",
    "lucid": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:e2e": "bun run scripts/e2e-stamp.ts && playwright test && bun run scripts/coverage-check.ts",
    "test:regression": "playwright test --project=regression",
    "verify:regressions": "bun run scripts/verify-regressions.ts",
    "test:e2e:soak": "bun run scripts/e2e-stamp.ts && playwright test --repeat-each=5",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "bun run build:client && lefthook install",
    "prototype:harness": "bun src/prototype-harness/index.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.29",
    "@assistant-ui/react-markdown": "^0.14.9",
    "@base-ui/react": "^1.7.0",
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.22.1",
    "linkedom": "^0.18.13",
    "lit": "^3.3.3",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.3",
    "tw-shimmer": "^0.4.12",
    "typescript": "^5.9.3"
  }
}
