{
  "name": "@dungle-scrubs/lucid",
  "version": "2.0.0-beta.2",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/server/client",
    "test": "bun test",
    "prepare": "test -d .git/hooks && git config --local core.hooksPath .git/hooks && lefthook install --force || true",
    "build": "bun scripts/build.ts",
    "build:reference": "bun scripts/build-reference.ts",
    "build:package": "bun scripts/build-package.ts",
    "prepack": "bun run build:package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "bun-plugin-tailwind": "0.1.2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "tailwindcss": "4.1.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.10",
    "@dungle-scrubs/harness-cli-normalizer": "0.6.5",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "dom-anchor-text-quote": "^4",
    "parse5": "8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "bin": {
    "lucid": "./dist/package/main.js"
  },
  "files": [
    "dist/package",
    "docs/artifacts.md",
    "skills/lucid",
    "skills/lucid-design"
  ],
  "description": "Review, annotate, and revise agent-authored documents with a durable local conversation.",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/lucid.git"
  },
  "homepage": "https://github.com/dungle-scrubs/lucid#readme",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
