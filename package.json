{
  "name": "lucid-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/server/client",
    "test": "bun test",
    "prepare": "test -d .git/hooks && git config --local core.hooksPath .git/hooks && lefthook install --force || true",
    "build": "bun build --compile --outfile dist/lucid2 src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.10",
    "@dungle-scrubs/harness-cli-normalizer": "0.5.7",
    "dom-anchor-text-quote": "^4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "bin": {
    "lucid2": "./dist/lucid2"
  },
  "files": [
    "dist"
  ]
}
