{
  "name": "lucid",
  "version": "0.1.0",
  "description": "Agent-agnostic CLI for addressable HTML artifacts and located agent-human review",
  "license": "MIT",
  "author": "Kevin Frilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/lucid.git"
  },
  "homepage": "https://github.com/dungle-scrubs/lucid#readme",
  "bugs": {
    "url": "https://github.com/dungle-scrubs/lucid/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "html",
    "artifact",
    "annotation",
    "review",
    "bun",
    "llm"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "src/cli/main.ts",
  "bin": {
    "lucid": "./dist/lucid"
  },
  "scripts": {
    "build:client": "bun run scripts/build-client.ts",
    "build:binary": "bun run scripts/build-binary.ts",
    "build": "bun run build:client && bun run build:binary",
    "lucid": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.26",
    "@base-ui/react": "^1.6.0",
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.2",
    "@effect/platform-bun": "^0.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.21.4",
    "linkedom": "^0.18.12",
    "lit": "^3.3.1",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4.3.2",
    "tw-shimmer": "^0.4.11",
    "typescript": "^5.9.0"
  }
}
