#!/usr/bin/expect -f
# A-002 human-side driver. Every typed prompt uses a separate carriage return.
set timeout 210
log_file -noappend pty.log

proc stamp {event} {
  set f [open "driver-events.log" "a"]
  puts $f "[clock milliseconds] $event"
  close $f
}
proc say {text event} {
  stamp $event
  send -- $text
  sleep 1
  send "\r"
}

spawn zsh -c {unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_PID CLAUDE_EFFORT HERDR_ENV; exec claude --setting-sources project --model sonnet --dangerously-skip-permissions}
set claude_pid [exp_pid]
set pf [open "processes.log" "a"]
puts $pf "SPAWN claude pid=$claude_pid purpose=A-002-interactive"
close $pf
expect {
  "Allow external CLAUDE.md file imports?" { stamp "EXTERNAL_IMPORT_PROMPT"; send "2"; sleep 1; send "\r"; exp_continue }
  -re {Try} { stamp "STARTUP_READY" }
  timeout {
    stamp "TIMEOUT_STARTUP_PROMPT"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=startup-prompt-timeout"
    close $pf
    exec kill -TERM $claude_pid
    exit 124
  }
}

say "Create files work/one.txt, work/two.txt, and work/three.txt, each containing the single word ready. Create them one at a time with a separate tool call each. Then state how many files you created." "TURN1_SUBMITTED"
expect {
  "FEEDBACK-ONE-APPLIED" { stamp "FEEDBACK_ONE_VISIBLE"; puts "MARK: feedback-one applied" }
  timeout {
    stamp "TIMEOUT_FEEDBACK_ONE"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=timeout-feedback-one"
    close $pf
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}
expect {
  -re {❯} { stamp "TURN1_PROMPT_READY" }
  timeout {
    stamp "TIMEOUT_TURN1_PROMPT"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=timeout-turn1-prompt"
    close $pf
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}

say "Reply with a two-line poem about rivers. Do not use any tools." "TURN2_SUBMITTED"
expect {
  "FEEDBACK-TWO-APPLIED" { stamp "FEEDBACK_TWO_VISIBLE"; puts "MARK: feedback-two applied at turn end" }
  timeout {
    stamp "TIMEOUT_FEEDBACK_TWO"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=timeout-feedback-two"
    close $pf
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}
expect {
  -re {❯} { stamp "TURN2_PROMPT_READY" }
  timeout { stamp "TIMEOUT_TURN2_PROMPT" }
}

say "Reply with exactly: still alive" "TURN3_SUBMITTED"
expect {
  "still alive" { stamp "TERMINAL_USABLE"; puts "MARK: terminal still serves its human" }
  timeout {
    stamp "TIMEOUT_STILL_ALIVE"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=timeout-still-alive"
    close $pf
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}
sleep 3
stamp "EXIT_REQUESTED"
send "/exit\r"
expect {
  eof { stamp "CLAUDE_EXITED_NATURALLY" }
  timeout {
    stamp "TIMEOUT_EXIT"
    set pf [open "processes.log" "a"]
    puts $pf "STOP claude pid=$claude_pid method=TERM reason=timeout-exit"
    close $pf
    exec kill -TERM $claude_pid
    sleep 5
  }
}
catch { close }
catch { wait }
