#!/usr/bin/expect -f
# A-002 (2.1.227) human-side driver.
# Turn 1: multi-tool turn + mid-turn injection (contract 1) + co-run (contract 2).
# Turn 2: tool-free reasoning window (contract 3 - transcript-flush sampling).
# Turn 3: terminal still serves its human.
set timeout 240
log_file -noappend pty.log

proc stamp {event} {
  set f [open "driver-events.log" "a"]
  puts $f "[clock milliseconds] $event"
  close $f
}
proc say {text event} {
  stamp $event
  send -- $text
  sleep 1
  send "\r"
}

spawn zsh -c {unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_PID CLAUDE_EFFORT HERDR_ENV; exec claude --setting-sources project --model sonnet --dangerously-skip-permissions}
set claude_pid [exp_pid]
set pf [open "processes.log" "a"]
puts $pf "SPAWN claude pid=$claude_pid purpose=A-002-227"
close $pf

# On 2.1.227 the TUI renders prompts with cursor-column escapes between words
# (Allow<ESC>[9Gexternal...), so a literal-string match never fires. Match
# regexes that tolerate the intervening escape bytes, and dismiss any startup
# prompt (external-imports, folder-trust) before treating the session ready.
expect {
  -re {Allow.+external.+imports} { stamp "EXTERNAL_IMPORT_PROMPT"; send "2"; sleep 1; send "\r"; exp_continue }
  -re {trust.+files.+folder} { stamp "TRUST_PROMPT"; send "1"; sleep 1; send "\r"; exp_continue }
  -re {bypass} { stamp "STARTUP_READY" }
  timeout {
    stamp "TIMEOUT_STARTUP"
    exec kill -TERM $claude_pid
    exit 124
  }
}

# --- Turn 1: multi-tool + mid-turn injection ---
say "Create files work/one.txt, work/two.txt, and work/three.txt, each containing the single word ready. Create them one at a time with a separate tool call each. Then state how many files you created." "TURN1_SUBMITTED"
expect {
  "FEEDBACK-ONE-APPLIED" { stamp "FEEDBACK_ONE_VISIBLE"; puts "MARK: feedback-one applied (mid-turn injection)" }
  timeout {
    stamp "TIMEOUT_FEEDBACK_ONE"
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}
expect {
  -re {❯} { stamp "TURN1_PROMPT_READY" }
  timeout { stamp "TIMEOUT_TURN1_PROMPT"; exec kill -TERM $claude_pid; sleep 5; exit 124 }
}

# --- Turn 2: tool-free reasoning window (contract 3) ---
# A prompt that produces a long, tool-free response so the sampler can watch
# whether the transcript advances during the working window.
say "Do NOT use any tools for this. Think carefully step by step, then write a detailed 400-word explanation of how a write-ahead log guarantees durability. End your reply with exactly: REASONING-DONE" "TURN2_SUBMITTED"
expect {
  "REASONING-DONE" { stamp "TURN2_DONE"; puts "MARK: tool-free reasoning turn complete" }
  timeout {
    stamp "TIMEOUT_TURN2"
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}
expect {
  -re {❯} { stamp "TURN2_PROMPT_READY" }
  timeout { stamp "TIMEOUT_TURN2_PROMPT" }
}

# --- Turn 3: terminal still usable ---
say "Reply with exactly: STILL-ALIVE" "TURN3_SUBMITTED"
expect {
  "STILL-ALIVE" { stamp "TERMINAL_USABLE"; puts "MARK: terminal still serves its human" }
  timeout {
    stamp "TIMEOUT_STILL_ALIVE"
    exec kill -TERM $claude_pid
    sleep 5
    exit 124
  }
}

sleep 2
stamp "EXIT_REQUESTED"
send "/exit\r"
expect {
  eof { stamp "CLAUDE_EXITED_NATURALLY" }
  timeout {
    stamp "TIMEOUT_EXIT"
    exec kill -TERM $claude_pid
    sleep 5
  }
}
catch { close }
catch { wait }
